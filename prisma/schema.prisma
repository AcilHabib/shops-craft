// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Product {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  handle           String
  availableForSale Boolean    @default(true)
  title            String
  description      String
  descriptionHtml  String
  tags             String[]
  priceRange       PriceRange

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  options  ProductOption[]
  variants ProductVariant[]
  images   Image[]
  seo      SEO?

  cartitem     CartItem?
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
}

model Collection {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  handle      String
  title       String
  description String
  path        String
  
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
  
  seo         SEO?
  product     Product[] // Simulated relation: list of Product IDs
}

model Cart {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  checkoutUrl   String
  totalQuantity Int
  cost          CartCost
  
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())
  
  lines         CartItem[] // Embedded items with product snapshot + ID
}

model ProductOption {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  values String[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model ProductVariant {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  availableForSale Boolean
  price            Money

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  selectedOptions SelectedOption[]

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model SelectedOption {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  value String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  merchandiseId    String?
  merchandise      Merchandise?    @relation(fields: [merchandiseId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
}

model Image {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  altText   String
  width     Int
  height    Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model SEO {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId    String?     @unique
  product      Product?    @relation(fields: [productId], references: [id])
  collectionId String?     @unique
  collection   Collection? @relation(fields: [collectionId], references: [id])
}

model CartItem {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  cost     CartItemCost

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  merchandise Merchandise[]

  productId String   @unique
  product   Product? @relation(fields: [productId], references: [id])
  cartId    String?
  cart      Cart?    @relation(fields: [cartId], references: [id])
}

model Merchandise {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  selectedOptions SelectedOption[]
  product         CartProduct[]
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  cartItemId String?
  cartItem   CartItem? @relation(fields: [cartItemId], references: [id])
}

model CartProduct {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  handle String
  title  String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  MerchandiseId String?
  merchandise   Merchandise? @relation(fields: [MerchandiseId], references: [id])
}

type Money {
  amount       String
  currencyCode String
}

type CartItemCost {
  totalAmount Money
}

type CartCost {
  subtotalAmount Money
  totalAmount    Money
  totalTaxAmount Money
}

type PriceRange {
  maxVariantPrice Money
  minVariantPrice Money
}
