// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}



model Product {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  handle           String
  availableForSale Boolean    @default(true)
  title            String
  description      String
  descriptionHtml  String
  tags             String[]
  priceRange       PriceRange
  isNew            Boolean?    @default(false)
  isOnSale         Boolean?    @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  featuredImageId String? @unique
  featuredImage   Image?  @relation("FeaturedImage", fields: [featuredImageId], references: [id])

  options  ProductOption[]
  variants ProductVariant[]
  images   Image[]          @relation("ProductImages")
  review   Review[]
  saleProduct SaleProduct[]
  seo      SEO?
  informations ProductInformations[]
  wishListItems WishListItem[]

  cartitem     CartItem[] 
  collectionId String?
  collection   Collection? @relation(fields: [collectionId], references: [id])
  categoryId   String?
  category     category? @relation(fields: [categoryId], references: [id])
}

model Collection {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  handle      String  @unique
  title       String
  description String
  path        String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // seo     SEO?
  product Product[] // Simulated relation: list of Product IDs
}

model category {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  handle      String @unique
  title       String
  description String
  path        String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  // seo     SEO?
  product Product[] // Simulated relation: list of Product IDs
}

model Cart {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  checkoutUrl   String
  totalQuantity Int
  cost          CartCost
  
  updatedAt     DateTime   @updatedAt
  createdAt     DateTime   @default(now())
  
  lines         CartItem[] 
  Order Order[]

  customerId String?   @unique @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id])
}

model Order{
  id String @id @default(auto()) @map("_id") @db.ObjectId
  deleveryType String 

  cartId String? @db.ObjectId
  cart Cart? @relation(fields: [cartId], references: [id])
  
  customerId String? @unique @db.ObjectId
  customer  Customer? @relation(fields: [customerId], references: [id])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  }


model Customer {
  id           String  @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String?
  lastName     String
  email        String?
  phone     String?
  isSubscribed Boolean @default(false)
  password    String?

  updatedAt DateTime  @updatedAt
  createdAt DateTime  @default(now())
  
  order     Order[]
  address   Address[]
  review    Review[]
  cart      Cart?
  feedback  Feedback?
  wishlist WishList[]
}

  model Address {
    id String @id @default (auto()) @map("_id") @db.ObjectId
    state String 
    city String 
    address String 
    appartment String?
    zipCode String

    customerId String ? @unique @db.ObjectId
    customer Customer? @relation (fields: [customerId], references: [id])

    updatedAt DateTime @updatedAt
    createdAt DateTime @default(now()) 

  }

model ProductOption {
  id     String   @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  values OptionValue[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

model OptionValue {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  value  String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productOptionId String?
  productOption   ProductOption? @relation(fields: [productOptionId], references: [id])
}

model ProductVariant {
  id               String  @id @default(auto()) @map("_id") @db.ObjectId
  title            String
  quantity         Int 
  availableForSale Boolean @default(true)
  price            Money

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  selectedOptions SelectedOption[]

  productId String?
  product   Product? @relation(fields: [productId], references: [id])
}

// this is the modal dedicated for the additional product informations (name: value)
model ProductInformations {
  id     String @id @default (auto()) @map("_id") @db.ObjectId
  name   String 
  value  String 

  createdAt DateTime @default (now())
  updatedAt DateTime @updatedAt 

  productId String? 
  product   Product? @relation ( fields: [productId], references: [id])

}

model SelectedOption {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  value String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  merchandiseId    String?
  merchandise      Merchandise?    @relation(fields: [merchandiseId], references: [id])
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id])
}

model Image {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  url        String
  altText    String
  isFeatured Boolean  @default(false)
  width      Int
  height     Int
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  productId String?
  product   Product? @relation("ProductImages", fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  featuredInProduct Product? @relation("FeaturedImage")
}


model WishList{
  id   String @id @default(auto()) @map("_id") @db.ObjectId 

  createdAt DateTime @default (now())
  updatedAt DateTime @updatedAt

  customerId String?
  customer Customer? @relation(fields:[customerId], references: [id])
  
  wishListItems WishListItem[]
} 


model WishListItem{
  id   String @id @default(auto()) @map("_id") @db.ObjectId 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishListId String?
  wishList  WishList? @relation(fields: [wishListId] , references: [id])

  productId String?
  product  Product? @relation(fields: [productId], references : [id])

}
model SEO {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId    String?     @unique
  product      Product?    @relation(fields: [productId], references: [id])
  // collectionId String?     @unique
  // collection   Collection? @relation(fields: [collectionId], references: [id])
}

model CartItem {
  id       String       @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  cost     CartItemCost

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  merchandise Merchandise[]

  productId String   
  product   Product  @relation(fields: [productId], references: [id])
  cartId    String?
  cart      Cart?    @relation(fields: [cartId], references: [id])
}

model Merchandise {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  
  updatedAt       DateTime         @updatedAt
  createdAt       DateTime         @default(now())

  product         CartProduct[]
  selectedOptions SelectedOption[]

  cartItemId String?
  cartItem   CartItem? @relation(fields: [cartItemId], references: [id])
}

model CartProduct {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  handle String
  title  String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  MerchandiseId String?
  merchandise   Merchandise? @relation(fields: [MerchandiseId], references: [id])
}

model Sale {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  title  String
  percentage Int

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  products SaleProduct[]
}

model SaleProduct {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  price  Money

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  productId String?  
  product   Product?  @relation(fields: [productId], references: [id])
  saleId    String?
  sale      Sale? @relation(fields: [saleId], references: [id])
}

model Review {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body      String
  rating    Int
  customerId String? @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id])
  productId  String? @db.ObjectId
  product    Product? @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
}

model Feedback {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  rating      Int
  comment    String
  customerId String? @unique @db.ObjectId
  customer   Customer? @relation(fields: [customerId], references: [id])
  createdAt DateTime @default(now())
}

type Money {
  amount       String
  currencyCode String
}

type CartItemCost {
  totalAmount Money
}

type CartCost {
  subtotalAmount Money
  totalAmount    Money
  totalTaxAmount Money
}

type PriceRange {
  maxVariantPrice Money
  minVariantPrice Money
}